rules_version = '2';

// Paste this in Firebase console > Firestore Database > Rules and click Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // A user only creates and edits their own profile and cannot change their role afterwards
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.role in ['customer', 'merchant'];
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // One store per merchant: the document id is the owner's uid, so only the owner can write it
    match /stores/{storeId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == storeId
        && request.resource.data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'merchant';
      allow delete: if signedIn() && request.auth.uid == storeId;
    }

    function isMerchant() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'merchant';
    }

    function validQuantityLeft() {
      return request.resource.data.quantityLeft is int
        && request.resource.data.quantityLeft >= 0
        && request.resource.data.quantityLeft <= request.resource.data.quantityTotal;
    }

    // A merchant creates and edits only the bags of their own store (storeId == their uid).
    // Customers may only change quantityLeft, within 0..quantityTotal: reserving (K8) and cancelling (K11).
    match /bags/{bagId} {
      allow read: if signedIn();
      allow create: if signedIn() && isMerchant() && request.resource.data.storeId == request.auth.uid
        && validQuantityLeft();
      allow update: if signedIn() && validQuantityLeft() && (
        (resource.data.storeId == request.auth.uid && request.resource.data.storeId == request.auth.uid)
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantityLeft'])
      );
      allow delete: if signedIn() && resource.data.storeId == request.auth.uid;
    }

    // Only the customer and the store of a reservation see it. A new reservation is always "reserved" and
    // belongs to the store of its bag. Afterwards only the status changes, and only away from "reserved":
    // the store marks it collected (H6), the customer cancels it (K11). Collected or cancelled is final.
    match /reservations/{reservationId} {
      allow read: if signedIn()
        && (resource.data.customerId == request.auth.uid || resource.data.storeId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'reserved'
        && request.resource.data.quantity is int && request.resource.data.quantity >= 1
        && get(/databases/$(database)/documents/bags/$(request.resource.data.bagId)).data.storeId == request.resource.data.storeId;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && resource.data.status == 'reserved'
        && (
          (resource.data.storeId == request.auth.uid && request.resource.data.status == 'collected')
          || (resource.data.customerId == request.auth.uid && request.resource.data.status == 'cancelled')
        );
    }
  }
}
