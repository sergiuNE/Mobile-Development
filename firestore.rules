rules_version = '2';

// Paste this in Firebase console > Firestore Database > Rules and click Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // A user only creates and edits their own profile and cannot change their role afterwards
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.role in ['customer', 'merchant'];
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // One store per merchant: the document id is the owner's uid, so only the owner can write it
    match /stores/{storeId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == storeId
        && request.resource.data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'merchant';
      allow delete: if signedIn() && request.auth.uid == storeId;
    }

    match /bags/{bagId} {
      allow read, write: if signedIn();
    }

    match /reservations/{reservationId} {
      allow read, write: if signedIn();
    }
  }
}
